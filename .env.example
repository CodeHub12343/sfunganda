# =============================================================================
# Sarah's Foundation — environment variables
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# =============================================================================

# --- Donations: Stripe Checkout (required for the Donate button to work) -----
# Your Stripe secret key. Use a test key (sk_test_…) in development and the
# live key (sk_live_…) in production. Find it at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Canonical site origin used for Stripe success/cancel redirects.
# Optional in production if requests carry an Origin header; set it to be safe.
NEXT_PUBLIC_SITE_URL=https://sfuganda.com

# --- Volunteers: where signups are sent (set at least one) -------------------
# A webhook that records the signup, e.g. a Google Apps Script / Zapier / Make
# endpoint that appends a row to a Google Sheet.
VOLUNTEER_WEBHOOK_URL=

# Email notifications via Resend (https://resend.com). Set all three to enable.
RESEND_API_KEY=
VOLUNTEER_NOTIFY_TO=
VOLUNTEER_NOTIFY_FROM=Sarah's Foundation <onboarding@resend.dev>
