# =============================================================================
# Sarah's Foundation — WEB environment template (Next.js only)
# API environment lives in server/.env.example
# =============================================================================

# Canonical origin, used in metadata and sitemap/robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Internal secret the Next.js middleware injects on `/api/v1/*` so the Express
# API trusts the request. MUST match server/.env INTERNAL_PROXY_SECRET.
INTERNAL_PROXY_SECRET=change-me-at-least-16-chars

# The Express API's internal origin. The browser never sees this value — it
# is used by Next.js rewrites and by Server Components calling `src/lib/api.ts`.
API_ORIGIN=http://localhost:4000

# Session cookie name — must match server/.env SESSION_COOKIE_NAME.
NEXT_PUBLIC_SESSION_COOKIE_NAME=sfu_session

# Optional: error-tracking DSN (Sentry or equivalent).
ERROR_TRACKING_DSN=

# Feature flag: switch the admin UI to the new mobile shell.
# Set to 1 in dev or on previews to opt in.
NEXT_PUBLIC_FLAG_ADMIN_MOBILESHELL=

