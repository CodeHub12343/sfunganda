{
  "name": "sarahs-foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Sarah's Foundation — humanitarian fundraising site",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:mobile": "playwright test --project=mobile-uganda",
    "audit": "npm audit --omit=dev --audit-level=high",
    "headers-scan": "node scripts/headers-scan.mjs",
    "perf-budget": "node scripts/perf-budget.mjs",
    "authz-matrix": "node scripts/authz-matrix.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "hls.js": "^1.7.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.19",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "styled-components": "^6.1.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^20.17.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
