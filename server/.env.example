# ---------------------------------------------------------------------------
# Sarah's Foundation — API environment template
# Copy to server/.env and fill in. Never commit secrets.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# HTTP
PORT=4000
# Comma-separated list of origins the API accepts cookies from.
# The Next.js front end is always first; add staging/production hosts here.
CORS_ORIGINS=http://localhost:3000

# Session cookie
SESSION_SECRET=change-me-to-a-32+char-random-string
SESSION_COOKIE_NAME=sfu_session
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=12
# Set to "true" in production and on preview environments served over https.
SESSION_COOKIE_SECURE=false

# MongoDB
MONGO_URI=mongodb://localhost:27017/sfuganda?replicaSet=rs0
MONGO_DB_NAME=sfuganda

# Mail (SMTP)
MAIL_FROM="Sarah's Foundation <no-reply@sfuganda.local>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# Public site URL — Stripe success/cancel redirects and invitation links.
PUBLIC_SITE_URL=http://localhost:3000

# Stripe (checkout moved from the Next.js API into this service)
STRIPE_SECRET_KEY=sk_test_replace_me

# Internal secret used by the front end to forward public requests to the
# API (the Next.js rewrite layer sets `x-internal-secret` on every proxied
# request so the API can distinguish site traffic from attacker traffic).
INTERNAL_PROXY_SECRET=change-me

# MFA
MFA_ISSUER=Sarah's Foundation
