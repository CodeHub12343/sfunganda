{
  "name": "@sfu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Sarah's Foundation — Express API + outbox worker",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "start:prod": "tsx src/server.ts",
    "migrate": "tsx migrations/run.ts",
    "migrate:private": "tsx migrations/private/run.ts",
    "seed": "tsx migrations/seed.ts",
    "seed:production": "tsx migrations/seed-production.ts",
    "audit": "npm audit --omit=dev --audit-level=high",
    "integrity": "tsx scripts/run-integrity.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.2",
    "nanoid": "^5.0.9",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "qrcode": "^1.5.4",
    "sarahs-foundation": "file:..",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.3",
    "pdf-parse": "^1.1.1",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
